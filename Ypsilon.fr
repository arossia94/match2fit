(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

gotoBFM={G[a__]->G[a]+GQuantum[a],Wi[a__]->Wi[a]+WiQuantum[a],B[a__]->B[a]+BQuantum[a]};


LHeavy := Block[{mu,ii,cc,nn}, DC[Sa[nn, cc], mu]*DC[Sabar[nn, cc], mu] + MSa^2 Sabar Sa ]/.gotoBFM;

 LNP:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},
L8[ff0,ff1] CC[QLbar[sp1,ss0,ff0,cc0]].QL[sp1,ss1,ff1,cc1] Sa[ss2, cc2] TC31[cc0, cc1, cc2] TS31[ss0, ss1, ss2]];

 LNPH:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},
L1 Phibar[ss0] Sabar[ss1, cc1] Phi[ss2] Sa[ss3, cc1] TS11[ss0, ss1, ss2, ss3] 
+ L2 Phibar[ss0] Sabar[ss1, cc1] Phi[ss2] Sa[ss3, cc1] TS12[ss0, ss1, ss2, ss3] 

(**
+ L3 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC21[cc0, cc1, cc2, cc3] TS21[ss0, ss1, ss2, ss3] 
+ L4 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC23[cc0, cc1, cc2, cc3] TS23[ss0, ss1, ss2, ss3] 
+ L5 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC25[cc0, cc1, cc2, cc3] TS25[ss0, ss1, ss2, ss3] 
+ L6 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC27[cc0, cc1, cc2, cc3] TS27[ss0, ss1, ss2, ss3] 
+ L7 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC29[cc0, cc1, cc2, cc3] TS29[ss0, ss1, ss2, ss3]
***)

];

Ltot := LSM + LHeavy + LNP + HC[LNP] + LNPH;