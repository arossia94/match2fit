(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

gotoBFM={G[a__]->G[a]+GQuantum[a],Wi[a__]->Wi[a]+WiQuantum[a],B[a__]->B[a]+BQuantum[a]};


LHeavy := Block[{mu,ii,cc,nn}, DC[Sa[nn, cc], mu]*DC[Sabar[nn, cc], mu] + MSa^2 Sabar Sa ]/.gotoBFM;

 LNP:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},

+L12[ff0,ff1] QLbar[sp1,ss0,ff0,cc0].DR[sp1,ff1,cc1] Sa[ss0, cc2] T[cc2, cc0, cc1] 
+ L13[ff0,ff1] URbar[sp1,ff0,cc0].QL[sp1,ss1,ff1,cc1] Sa[ss2, cc2] T[cc2, cc0, cc1] TS61[ss1, ss2] 
(*
+ L1 Sabar[ss0, cc0] Sabar[ss1, cc1] Phi[ss2] Phi[ss3] TC12[cc0, cc1] TS12[ss0, ss1, ss2, ss3] 
+ L4 Sabar[ss0, cc0] Sabar[ss1, cc1] Phi[ss2] Sa[ss3, cc3] TC32[cc0, cc1, cc3] TS32[ss0, ss1, ss2, ss3] 
+ L5 Sabar[ss0, cc0] Sabar[ss1, cc1] Phi[ss2] Sa[ss3, cc3] TC34[cc0, cc1, cc3] TS34[ss0, ss1, ss2, ss3]
*)
];

 LNPH:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},

(*
+L10 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC414[cc0, cc1, cc2, cc3] TS414[ss0, ss1, ss2, ss3] 
+ L11 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC415[cc0, cc1, cc2, cc3] TS415[ss0, ss1, ss2, ss3]
*)
 
+ L2 Phibar[ss0] Sabar[ss1, cc1] Phi[ss2] Sa[ss3, cc1]  TS21[ss0, ss1, ss2, ss3] 
+ L3 Phibar[ss0] Sabar[ss1, cc1] Phi[ss2] Sa[ss3, cc1]  TS22[ss0, ss1, ss2, ss3] 

(*
+ L6 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC42[cc0, cc1, cc2, cc3] TS42[ss0, ss1, ss2, ss3] 
+ L7 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC43[cc0, cc1, cc2, cc3] TS43[ss0, ss1, ss2, ss3] 
+ L8 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC45[cc0, cc1, cc2, cc3] TS45[ss0, ss1, ss2, ss3] 
+ L9 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC412[cc0, cc1, cc2, cc3] TS412[ss0, ss1, ss2, ss3]
*)
];

Ltot := LSM + LHeavy + LNP + HC[LNP] + LNPH;