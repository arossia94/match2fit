M$ModelName = "w1";


FeynmanGauge = True;

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {

S[667]=={ClassName->Sa,
SelfConjugate->False,
QuantumNumbers->{Y-> -1/3},
Indices->{Index[Colour]},
FullName->"heavy",
Mass->MSa,
Width->0}};

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* External parameters *)

  (* Internal Parameters *)
  
MSa== { 
    ParameterType     -> Internal, 
    ComplexParameter  -> False
  },
TS11=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC11=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour]},
ComplexParameter->True},
L1=={
ParameterType->Internal,
ComplexParameter->False},
TC21=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour], Index[Colour], Index[Colour]},
ComplexParameter->True},
L2=={
ParameterType->Internal,
ComplexParameter->False},
TC31=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour], Index[Colour]},
ComplexParameter->True},
L3=={
ParameterType->Internal,
Indices-> {Index[Generation],Index[Generation]},
ComplexParameter->True},
TS41=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC41=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour], Index[Colour]},
ComplexParameter->True},
L4=={
ParameterType->Internal,
Indices-> {Index[Generation],Index[Generation]},
ComplexParameter->True},
TC51=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour]},
ComplexParameter->True},
L5=={
ParameterType->Internal,
Indices-> {Index[Generation],Index[Generation]},
ComplexParameter->True},
TS61=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC61=={
