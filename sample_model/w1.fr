(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

gotoBFM={G[a__]->G[a]+GQuantum[a],Wi[a__]->Wi[a]+WiQuantum[a],B[a__]->B[a]+BQuantum[a]};


LHeavy := Block[{mu,ii,cc,nn}, DC[Sa[nn], mu]*DC[Sabar[nn], mu] + MSa^2 Sabar Sa ]/.gotoBFM;

 LNP:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},L3[ff0,ff1] CC[DRbar[sp1,ff0,cc0]].UR[sp1,ff1,cc2] Sa[cc1] TC31[cc0, cc1, cc2] + L4[ff0,ff1] CC[QLbar[sp1,ss0,ff0,cc0]].QL[sp1,ss1,ff1,cc1] Sa[cc2] TC41[cc0, cc1, cc2] TS41[ss0, ss1] + L5[ff0,ff1] CC[LRbar[sp1,ff0]].UR[sp1,ff1,cc2] Sabar[cc0] TC51[cc0, cc2] + L6[ff0,ff1] CC[LLbar[sp1,ss1,ff0]].QL[sp1,ss2,ff1,cc2] Sabar[cc0] TC61[cc0, cc2] TS61[ss1, ss2]];

 LNPH:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},L1 Phibar[ss0] Sabar[cc1] Phi[ss2] Sa[cc3] TC11[cc1, cc3] TS11[ss0, ss2] + L2 Sabar[cc0] Sabar[cc1] Sa[cc2] Sa[cc3] TC21[cc0, cc1, cc2, cc3]];

Ltot := LSM + LHeavy + LNP + HC[LNP] + LNPH;