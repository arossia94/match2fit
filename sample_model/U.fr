(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)
M$ModelName = "U";


FeynmanGauge = True;

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {

F[667]=={ClassName->Fa,
SelfConjugate->False,
QuantumNumbers->{Y-> 2/3},
Indices->{Index[Colour]},
FullName->"heavy",
Mass->MFa,
Width->0}};

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* External parameters *)

  (* Internal Parameters *)
  
MFa== { 
    ParameterType     -> Internal, 
    ComplexParameter  -> False
  },
TS11=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC11=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour]},
ComplexParameter->True},
L1=={
ParameterType->Internal,
Indices-> {Index[Generation]},
ComplexParameter->True}};


(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

gotoBFM={G[a__]->G[a]+GQuantum[a],Wi[a__]->Wi[a]+WiQuantum[a],B[a__]->B[a]+BQuantum[a]};


LHeavy := Block[{mu,ii,cc,nn}, I*Fabar.Ga[mu].DC[Fa,mu] + MFa*Fabar.Fa ]/.gotoBFM;

 LNP:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},L1[ff0] Fabar[sp1,cc0].QL[sp1,ss2,ff0,cc2] Phi[ss1] TC11[cc0, cc2] TS11[ss1, ss2]];

Ltot := LSM + LHeavy + LNP + HC[LNP];