(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)
M$ModelName = "Q1";


FeynmanGauge = True;

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {

F[667]=={ClassName->Fx,
SelfConjugate->False,
QuantumNumbers->{Y-> 1/6},
Indices->{Index[SU2D], Index[Colour]},
FullName->"heavy",
Mass->MFx,
Width->0}};

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* External parameters *)

  (* Internal Parameters *)
  
MFx== { 
    ParameterType     -> Internal, 
    ComplexParameter  -> False
  },
TS11=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC11=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour]},
ComplexParameter->True},
L1=={
ParameterType->Internal,
Indices-> {Index[Generation]},
ComplexParameter->True},
TS21=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC21=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour]},
ComplexParameter->True},
L2=={
ParameterType->Internal,
Indices-> {Index[Generation]},
ComplexParameter->True}};


(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

gotoBFM={G[a__]->G[a]+GQuantum[a],Wi[a__]->Wi[a]+WiQuantum[a],B[a__]->B[a]+BQuantum[a]};


LHeavy := Block[{mu,ii,cc,nn}, I*Fxbar.Ga[mu].DC[Fx,mu] + MFx*Fxbar.Fx ]/.gotoBFM;

 LNP:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},L1[ff0] URbar[sp1,ff0,cc0].Fx[sp1,ss1,cc1] Phi[ss2] TC11[cc0, cc1] TS11[ss1, ss2] + L2[ff0] Fxbar[sp1,ss0,cc0].DR[sp1,ff0,cc1] Phi[ss2] TC21[cc0, cc1] TS21[ss0, ss2]];

Ltot := LSM + LHeavy + LNP + HC[LNP];