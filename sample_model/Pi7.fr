(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)
M$ModelName = "Pi7";


FeynmanGauge = True;

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {

S[667]=={ClassName->Sa,
SelfConjugate->False,
QuantumNumbers->{Y-> 7/6},
Indices->{Index[SU2D], Index[Colour]},
FullName->"heavy",
Mass->MSa,
Width->0}};

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* External parameters *)

  (* Internal Parameters *)
  
MSa== { 
    ParameterType     -> Internal, 
    ComplexParameter  -> False
  },
TS11=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC11=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour]},
ComplexParameter->True},
TS12=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC12=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour]},
ComplexParameter->True},
L1=={
ParameterType->Internal,
ComplexParameter->False},
L2=={
ParameterType->Internal,
ComplexParameter->False},
TS22=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC22=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour], Index[Colour], Index[Colour]},
ComplexParameter->True},
TS23=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC23=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour], Index[Colour], Index[Colour]},
ComplexParameter->True},
L3=={
ParameterType->Internal,
ComplexParameter->False},
L4=={
ParameterType->Internal,
ComplexParameter->False},
TS31=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC31=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour]},
ComplexParameter->True},
L5=={
ParameterType->Internal,
Indices-> {Index[Generation],Index[Generation]},
ComplexParameter->True},
TS41=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC41=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour]},
ComplexParameter->True},
L6=={
ParameterType->Internal,
