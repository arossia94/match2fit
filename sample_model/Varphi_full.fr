ComplexParameter->True}};


(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

gotoBFM={G[a__]->G[a]+GQuantum[a],Wi[a__]->Wi[a]+WiQuantum[a],B[a__]->B[a]+BQuantum[a]};


LHeavy := Block[{mu,ii,cc,nn}, DC[Sa[nn], mu]*DC[Sabar[nn], mu] + MSa^2 Sabar Sa ]/.gotoBFM;

 LNP:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},
L1 Phibar[ss0] Sabar[ss1] Phi[ss2] Phi[ss3] TS12[ss0, ss1, ss2, ss3] 
+ L2 Sabar[ss0] Sabar[ss1] Phi[ss2] Phi[ss3] TS22[ss0, ss1, ss2, ss3]
(*+ L5 Sabar[ss0] Sabar[ss1] Phi[ss2] Sa[ss3] TS42[ss0, ss1, ss2, ss3] *)
+ L7[ff0,ff1] QLbar[sp1,ss0,ff0,cc0].DR[sp1,ff1,cc0] Sa[ss0]  
+ L8[ff0,ff1] LLbar[sp1,ss0,ff0].LR[sp1,ff1] Sa[ss0] 
+ L9[ff0,ff1] URbar[sp1,ff0,cc0].QL[sp1,ss1,ff1,cc0] Sa[ss2] TS81[ss1, ss2]
];

 LNPH:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},
L3 Phibar[ss0] Sabar[ss1] Phi[ss2] Sa[ss3] TS31[ss0, ss1, ss2, ss3] 
+ L4 Phibar[ss0] Sabar[ss1] Phi[ss2] Sa[ss3] TS32[ss0, ss1, ss2, ss3] 
(*+ L6 Sabar[ss0] Sabar[ss1] Sa[ss2] Sa[ss3] TS52[ss0, ss1, ss2, ss3]*)];

Ltot := LSM + LHeavy + LNP + HC[LNP] + LNPH;