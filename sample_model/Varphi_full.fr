(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)
M$ModelName = "phi";


FeynmanGauge = True;

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {

S[667]=={ClassName->Sa,
SelfConjugate->False,
QuantumNumbers->{Y-> 1/2},
Indices->{Index[SU2D]},
FullName->"heavy",
Mass->MSa,
Width->0}};

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* External parameters *)

  (* Internal Parameters *)
  
MSa== { 
    ParameterType     -> Internal, 
    ComplexParameter  -> False
  },
 TS12=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
ComplexParameter->True},
L1=={
ParameterType->Internal,
ComplexParameter->True},
 TS22=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
ComplexParameter->True},
L2=={
ParameterType->Internal,
ComplexParameter->True},
 TS31=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
ComplexParameter->True},
 TS32=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
ComplexParameter->True},
L3=={
ParameterType->Internal,
ComplexParameter->False},
L4=={
ParameterType->Internal,
ComplexParameter->False},
 TS42=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
ComplexParameter->True},
L5=={
ParameterType->Internal,
ComplexParameter->True},
 TS52=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
ComplexParameter->True},
L6=={
ParameterType->Internal,
ComplexParameter->False},
TS61=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC61=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour]},
ComplexParameter->True},
L7=={
ParameterType->Internal,
Indices-> {Index[Generation],Index[Generation]},
ComplexParameter->True},
 TS71=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
L8=={
ParameterType->Internal,
Indices-> {Index[Generation],Index[Generation]},
ComplexParameter->True},
TS81=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC81=={
ParameterType->Internal,
