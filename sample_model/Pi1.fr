(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

gotoBFM={G[a__]->G[a]+GQuantum[a],Wi[a__]->Wi[a]+WiQuantum[a],B[a__]->B[a]+BQuantum[a]};


LHeavy := Block[{mu,ii,cc,nn}, DC[Sa[nn, cc], mu]*DC[Sabar[nn, cc], mu] + MSa^2 Sabar Sa ]/.gotoBFM;

 LNP:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},L1 Phibar[ss0] Sa[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC11[cc1, cc2, cc3] TS11[ss0, ss1, ss2, ss3] + L6[ff0,ff1] CC[DRbar[sp1,ff0,cc0]].QL[sp1,ss1,ff1,cc1] Sa[ss2, cc2] TC41[cc0, cc1, cc2] TS41[ss1, ss2] + L7[ff0,ff1] CC[LLbar[sp1,ss1,ff0]].UR[sp1,ff1,cc2] Sabar[ss0, cc0] TC51[cc0, cc2] TS51[ss0, ss1] + L8[ff0,ff1] DRbar[sp1,ff0,cc0].LL[sp1,ss1,ff1] Sa[ss2, cc2] TC61[cc0, cc2] TS61[ss1, ss2]];

 LNPH:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},L2 Phibar[ss0] Sabar[ss1, cc1] Phi[ss2] Sa[ss3, cc3] TC21[cc1, cc3] TS21[ss0, ss1, ss2, ss3] + L3 Phibar[ss0] Sabar[ss1, cc1] Phi[ss2] Sa[ss3, cc3] TC22[cc1, cc3] TS22[ss0, ss1, ss2, ss3] + L4 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC32[cc0, cc1, cc2, cc3] TS32[ss0, ss1, ss2, ss3] + L5 Sabar[ss0, cc0] Sabar[ss1, cc1] Sa[ss2, cc2] Sa[ss3, cc3] TC33[cc0, cc1, cc2, cc3] TS33[ss0, ss1, ss2, ss3]];

Ltot := LSM + LHeavy + LNP + HC[LNP] + LNPH;