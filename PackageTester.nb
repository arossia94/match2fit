Cell["\<\
The function flavourSolver considers general SM yukawas, with the notation \
they appear in the matching results. 
We can force them to be real and diagonal.\
\>", "Text",
 CellChangeTimes->{{3.899365419608988*^9, 3.8993654682413406`*^9}, {
  3.961813005308323*^9, 
  3.9618130227839375`*^9}},ExpressionUUID->"573a793c-e637-4ede-9d8b-\
d32ee89416a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"realDiagSMYukas", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"yu", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "1"}], "]"}], 
          RowBox[{"yu", "[", 
           RowBox[{"1", ",", "1"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "2"}], "]"}], 
          RowBox[{"yu", "[", 
           RowBox[{"2", ",", "2"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "3"}], "]"}], 
          RowBox[{"yu", "[", 
           RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{"yd", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"j", ",", "1"}], "]"}], "*", 
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "1"}], "]"}], "*", 
         RowBox[{"yd", "[", 
          RowBox[{"1", ",", "1"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"j", ",", "2"}], "]"}], "*", 
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "2"}], "]"}], "*", 
         RowBox[{"yd", "[", 
          RowBox[{"2", ",", "2"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"j", ",", "3"}], "]"}], "*", 
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "3"}], "]"}], "*", 
         RowBox[{"yd", "[", 
          RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"yl", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "1"}], "]"}], 
          RowBox[{"yl", "[", 
           RowBox[{"1", ",", "1"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "2"}], "]"}], 
          RowBox[{"yl", "[", 
           RowBox[{"2", ",", "2"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "3"}], "]"}], 
          RowBox[{"yl", "[", 
           RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"yubar", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "1"}], "]"}], 
          RowBox[{"yu", "[", 
           RowBox[{"1", ",", "1"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "2"}], "]"}], 
          RowBox[{"yu", "[", 
           RowBox[{"2", ",", "2"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "3"}], "]"}], 
          RowBox[{"yu", "[", 
           RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ydbar", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "1"}], "]"}], 
          RowBox[{"yd", "[", 
           RowBox[{"1", ",", "1"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "2"}], "]"}], 
          RowBox[{"yd", "[", 
           RowBox[{"2", ",", "2"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "3"}], "]"}], 
          RowBox[{"yd", "[", 
           RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ylbar", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"j", ",", "1"}], "]"}], 
          RowBox[{"yl", "[", 
           RowBox[{"1", ",", "1"}], "]"}]}], "+", 
