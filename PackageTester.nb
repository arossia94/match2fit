 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"1", ",", "4"}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "979d5c14-c0a9-4778-ba14-97cbae44865e"],
