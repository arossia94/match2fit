Cell[CellGroupData[{

Cell["Granada collection", "Subsection",
 CellChangeTimes->{{3.9624419628812428`*^9, 3.962441969472485*^9}, 
   3.963029022353031*^9},ExpressionUUID->"2fb4a967-daa6-43c6-b865-\
d85cdc6ac61b"],

Cell[TextData[{
 "The \"Granada collection\" contains all the 1-particle models considered in \
the \"Granada dictionary\" (arXiv:1711.10391), except for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "1"], TraditionalForm]],ExpressionUUID->
  "fd59c28d-6ccd-477a-99aa-9ca343a3624e"],
 ", matched at tree-level and with UV flavour assumptions that make them \
respect the SMEFTatNLO/SMEFiT flavour symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"U", "(", "2", ")"}], "q"], "x", " ", 
    SubscriptBox[
     RowBox[{"U", "(", "2", ")"}], "u"], "x", " ", 
    SubscriptBox[
     RowBox[{"U", "(", "3", ")"}], "d"], "x", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        RowBox[{"U", "(", "1", ")"}], "l"], "x", " ", 
       SubscriptBox[
        RowBox[{"U", "(", "1", ")"}], "e"]}], ")"}], "3"]}], 
   TraditionalForm]],ExpressionUUID->"f7972fea-25a1-452a-bc7a-d76c910b2b62"],
 " after tree-level matching.\nThese cards have been used in arXiv: \
2309.04523, 2404.12809, 2502.20453, 2505.00272, 2506.15390."
}], "Text",
 CellChangeTimes->{{3.963029041593029*^9, 3.963029191378179*^9}, {
  3.963029501562028*^9, 
  3.963029535874978*^9}},ExpressionUUID->"a956ad73-97ea-43a0-9216-\
4712fc2bdf70"],

Cell[CellGroupData[{

Cell["UV scans", "Subsubsection",
 CellChangeTimes->{{3.96302035937118*^9, 
  3.963020362740299*^9}},ExpressionUUID->"873e9e40-0960-42f3-b6b4-\
2e3d728865c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"ii", "==", "28"}], ",", 
      RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"//", 
       RowBox[{
        RowBox[{"/", " ", "Skips"}], " ", "L1", " ", 
        RowBox[{"model", "."}]}]}], " ", "//", "/"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"condFlaSym", "=", 
     RowBox[{"Get", "[", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], 
       "<>", "\"\</sample_results/Granada_Collection/Flavour_Sym_Cond_SMEFiT_\
Tree_Level_Mod_\>\"", "<>", 
       RowBox[{"ToString", "[", "ii", "]"}], 
       "<>", "\"\<_25_07_2025.dat\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"matchResToUVscanCard", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], 
       "<>", "\"\</sample_results/Granada_Collection/Matching_Result_Tree_\
Level_Mod_\>\"", "<>", 
       RowBox[{"ToString", "[", "ii", "]"}], 
       "<>", "\"\<_25_07_2025.dat\>\""}], ",", "1", ",", "0", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<UVFlavourAssumption\>\"", "->", 
         RowBox[{"Join", "[", 
          RowBox[{"realDiagSMYukas", ",", "condFlaSym"}], "]"}]}], ",", 
        RowBox[{"\"\<Collection\>\"", "->", "\"\<Granada\>\""}], ",", 
        RowBox[{"\"\<Model\>\"", "->", 
         RowBox[{"ToString", "[", "ii", "]"}]}], ",", 
        RowBox[{"\"\<OutputFormat\>\"", "->", "\"\<SMEFiT\>\""}], ",", 
        RowBox[{"\"\<UVinvariants\>\"", "->", "\"\<False\>\""}]}], "}"}]}], 
     "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "ii", "]"}], ";"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"ii", ",", "2", ",", "49"}], "}"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
