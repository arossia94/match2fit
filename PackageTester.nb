Cell["\<\
The warning appears because, despite the matching being at tree-level, \
matchmakereft always applies the evanescent shifts that contain one - loop \
order pieces, see https://gitlab.com/m4103/matchmaker-eft/-/issues/12. These \
one-loop shifts are removed when considering tree-level matching results.\
\>", "Text",
 CellChangeTimes->{{3.9080215729027643`*^9, 3.9080216242649918`*^9}, {
  3.9080216568284388`*^9, 3.9080217099286623`*^9}, {3.9618115568050976`*^9, 
  3.9618116105967064`*^9}},ExpressionUUID->"f4edd3d6-d345-47af-a003-\
87dbac548da7"],

Cell["\<\
These functions work well with the addition of some UV flavour assumptions. \
\>", "Text",
 CellChangeTimes->{{3.8993652713296022`*^9, 3.8993652885525665`*^9}, {
  3.9080217147600417`*^9, 3.9080217164288964`*^9}, {3.961811618271559*^9, 
  3.961811623547514*^9}},ExpressionUUID->"393bd514-0360-42dc-83f1-\
e1cc2de741ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"flavourSymChecker", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"NotebookDirectory", "[", "]"}], 
    "<>", "\"\</sample_results/MatchingResult_multiparticle_treelevel.dat\>\""}\
], ",", 
   RowBox[{"{", 
    RowBox[{"\"\<UVFlavourAssumption\>\"", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"lambdaQ1", "[", "i_", "]"}], "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "3"}], "]"}], "*", 
         RowBox[{"lamQ1uf", "[", "3", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"lambdaQ7", "[", "i_", "]"}], "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "3"}], "]"}], "*", 
         RowBox[{"lamQ7f3", "[", "3", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"lambdaQ1bar", "[", "i_", "]"}], "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "3"}], "]"}], "*", 
         RowBox[{"lamQ1uf", "[", "3", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"lambdaQ7bar", "[", "i_", "]"}], "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "3"}], "]"}], "*", 
         RowBox[{"lamQ7f3", "[", "3", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"gWtiQ", "[", 
         RowBox[{"i_", ",", "j_"}], "]"}], "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "j"}], "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"i", ",", "1"}], "]"}], 
            RowBox[{"gWqf", "[", 
             RowBox[{"1", ",", "1"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"i", ",", "2"}], "]"}], 
            RowBox[{"gWqf", "[", 
             RowBox[{"1", ",", "1"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"i", ",", "3"}], "]"}], 
            RowBox[{"gWqf", "[", 
             RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"gWtiLe", "[", 
         RowBox[{"i_", ",", "j_"}], "]"}], "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "j"}], "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"i", ",", "1"}], "]"}], 
            RowBox[{"gWLf", "[", 
             RowBox[{"1", ",", "1"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"i", ",", "2"}], "]"}], 
            RowBox[{"gWLf", "[", 
             RowBox[{"2", ",", "2"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"i", ",", "3"}], "]"}], 
            RowBox[{"gWLf", "[", 
             RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}]}], "}"}]}], 
    "}"}]}], "]"}]], "Input",
