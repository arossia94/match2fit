Cell[TextData[{
 "This is the heavy scalar doublet model, with gauge charges ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"1", ",", "2"}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "172eb616-59a9-46f7-b623-3c4025a04aea"],
 ". It represents a 2HDM model in the decoupling and alignment limit.\nThe \
cards for this model have been used in arXiv: 2309.04523, 2404.12809, \
2502.20453, 2505.00272, 2506.15390."
}], "Text",
 CellChangeTimes->{{3.963028174203527*^9, 3.963028217971552*^9}, {
   3.963029212001541*^9, 3.963029282065166*^9}, 
   3.9630293219217043`*^9},ExpressionUUID->"b4bc069c-6d32-4c89-9cd8-\
7339f96ce12b"],

