0268ee26220b"],

Cell[TextData[{
 "The function flavourSymChecker checks if certain matching results fulfill \
the baseline SMEFiT flavour symmetry, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"U", "(", "2", ")"}], "q"], "x", " ", 
    SubscriptBox[
     RowBox[{"U", "(", "2", ")"}], "u"], "x", " ", 
    SubscriptBox[
     RowBox[{"U", "(", "3", ")"}], "d"], "x", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        RowBox[{"U", "(", "1", ")"}], "l"], "x", " ", 
       SubscriptBox[
        RowBox[{"U", "(", "1", ")"}], "e"]}], ")"}], "3"]}], 
   TraditionalForm]],ExpressionUUID->"c194f677-9e9b-e04d-8830-5b6677c214b8"],
 "."
}], "Text",
