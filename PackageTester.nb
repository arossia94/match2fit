  SubscriptBox["T", "1"], 
  TraditionalForm]],ExpressionUUID->"8789012e-b992-4c8f-b155-12992f40599a"]], \
"Subsubsection",
 CellChangeTimes->{{3.9427416757826233`*^9, 
  3.942741677059058*^9}},ExpressionUUID->"8d26a702-86a5-478d-a63e-\
41d2fc83835f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "1"], TraditionalForm]],ExpressionUUID->
  "eb709960-9897-4580-8d80-5acd3eba10c5"],
 " is a vector-like heavy fermion, in the irrep ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"3", ",", "3"}], ")"}], 
    RowBox[{
     RowBox[{"-", "1"}], "/", "3"}]], TraditionalForm]],ExpressionUUID->
  "4846fa59-c9c5-48f5-a7c6-45ae0e7f252e"],
 ". First, we print some cards for UV scans and the for the mass scan.\nThe \
cards for this model have been used in arXiv: 2309.04523, 2404.12809, \
2502.20453, 2505.00272, 2506.15390."
}], "Text",
 CellChangeTimes->{{3.963028690340601*^9, 3.96302873885361*^9}, {
  3.963029329569663*^9, 
  3.963029329780664*^9}},ExpressionUUID->"d11a38fa-1d61-43ab-a007-\
665d4cce7506"],

