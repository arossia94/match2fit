Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"flavourSymChecker", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"NotebookDirectory", "[", "]"}], 
    "<>", "\"\</sample_results/MatchingResult_multiparticle_treelevel.dat\>\""}\
], ",", 
   RowBox[{"{", 
    RowBox[{"\"\<UVFlavourAssumption\>\"", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"lambdaQ1", "[", "i_", "]"}], "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "3"}], "]"}], "*", 
         RowBox[{"lamQ1uf", "[", "3", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"lambdaQ7", "[", "i_", "]"}], "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "3"}], "]"}], "*", 
         RowBox[{"lamQ7f3", "[", "3", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"lambdaQ1bar", "[", "i_", "]"}], "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"KroneckerDelta", "[", 
