Cell[TextData[{
 "This is the custodial quadruplet model that combines ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalTheta]", 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "c933f8f7-a996-4e10-8cac-3d7627ee1e71"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalTheta]", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "7845fc46-e6d0-4009-aafd-b331a41159a7"],
 " into a custodial bi-quadruplet.\nThe UV assumptions are chosen to \
reproduce the results in arXiv:2209.00666\nThe cards for this model have been \
used in arXiv: 2502.20453, 2504.05974, 2505.00272, 2506.15390."
}], "Text",
 CellChangeTimes->{{3.963028690340601*^9, 3.96302873885361*^9}, {
