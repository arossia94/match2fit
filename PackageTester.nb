Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"writeTabBlock", "[", "varsUV_", "]"}], "[", 
   RowBox[{"elem_", ",", "index_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "tab", "}"}], ",", 
    RowBox[{
     RowBox[{"tab", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{"CForm", "[", 
            RowBox[{"varsUV", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
          RowBox[{"Piecewise", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"StringReplace", "[", 
                RowBox[{
                 RowBox[{"ToString", "[", 
                  RowBox[{"InputForm", "[", "elem", "]"}], "]"}], ",", 
                 RowBox[{"\"\<*^\>\"", "->", "\"\<e\>\""}]}], "]"}], ",", 
               RowBox[{"i", "==", "1"}]}], "}"}], "}"}], ",", "\"\<1\>\""}], 
           "]"}], ",", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"index", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", "1"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "varsUV", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\n", "tab"}]}], "]"}]}]], "Code",
 CellLabel->"In[4]:=",ExpressionUUID->"b30a1b36-9a59-41f4-8c5f-b2a2d50604a7"],

