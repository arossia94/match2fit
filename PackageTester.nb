         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"i", ",", "3"}], "]"}], "*", 
         RowBox[{"lamQ7f3", "[", "3", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"gWtiQ", "[", 
