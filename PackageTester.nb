Cell[CellGroupData[{

Cell["Flavour symmetry fulfillment", "Section",
 CellChangeTimes->{{3.9618112833653297`*^9, 3.961811289345314*^9}, {
  3.9618113468201294`*^9, 
  3.9618113494880447`*^9}},ExpressionUUID->"bab2c408-f486-3b4e-aae3-\
0268ee26220b"],

Cell[TextData[{
 "The function flavourSymChecker checks if certain matching results fulfill \
the baseline SMEFiT flavour symmetry, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"U", "(", "2", ")"}], "q"], "x", " ", 
    SubscriptBox[
     RowBox[{"U", "(", "2", ")"}], "u"], "x", " ", 
    SubscriptBox[
     RowBox[{"U", "(", "3", ")"}], "d"], "x", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        RowBox[{"U", "(", "1", ")"}], "l"], "x", " ", 
       SubscriptBox[
        RowBox[{"U", "(", "1", ")"}], "e"]}], ")"}], "3"]}], 
   TraditionalForm]],ExpressionUUID->"c194f677-9e9b-e04d-8830-5b6677c214b8"],
 "."
}], "Text",
 CellChangeTimes->{{3.8993652256485734`*^9, 3.8993652374894514`*^9}, {
