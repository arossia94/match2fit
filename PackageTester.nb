Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"modelToUVscanCard", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<sample_model/\>\""}], 
   ",", "\"\<Q17_W1\>\"", ",", "1", ",", "\"\<Tree\>\"", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<UVFlavourAssumption\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"lambdaQ1", "[", "i_", "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "3"}], "]"}], "*", 
          RowBox[{"lamQ1uf", "[", "3", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"lambdaQ7", "[", "i_", "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "3"}], "]"}], "*", 
          RowBox[{"lamQ7f3", "[", "3", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"lambdaQ1bar", "[", "i_", "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "3"}], "]"}], "*", 
          RowBox[{"lamQ1uf", "[", "3", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"lambdaQ7bar", "[", "i_", "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "3"}], "]"}], "*", 
          RowBox[{"lamQ7f3", "[", "3", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"gWtiQ", "[", 
          RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "j"}], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "1"}], "]"}], 
             RowBox[{"gWqf", "[", 
              RowBox[{"1", ",", "1"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "2"}], "]"}], 
             RowBox[{"gWqf", "[", 
              RowBox[{"1", ",", "1"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "3"}], "]"}], 
             RowBox[{"gWqf", "[", 
              RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{"gWtiLe", "[", 
          RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "j"}], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "1"}], "]"}], 
