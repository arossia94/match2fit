              RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{"gWtiLe", "[", 
          RowBox[{"i_", ",", "j_"}], "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "j"}], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "1"}], "]"}], 
             RowBox[{"gWLf", "[", 
              RowBox[{"1", ",", "1"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "2"}], "]"}], 
             RowBox[{"gWLf", "[", 
              RowBox[{"2", ",", "2"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "3"}], "]"}], 
             RowBox[{"gWLf", "[", 
              RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}]}], "}"}]}], ",", 
     RowBox[{"\"\<Collection\>\"", "->", "\"\<MultiParticleCollection\>\""}], 
     ",", 
     RowBox[{"\"\<Model\>\"", "\[Rule]", "\"\<Q1_Q7_W\>\""}]}], "}"}]}], 
  "]"}]], "Input",
