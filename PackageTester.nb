          RowBox[{"lamQ1uf", "[", "3", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"lambdaQ7", "[", "i_", "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "3"}], "]"}], "*", 
          RowBox[{"lamQ7f3", "[", "3", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"lambdaQ1bar", "[", "i_", "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "3"}], "]"}], "*", 
          RowBox[{"lamQ1uf", "[", "3", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"lambdaQ7bar", "[", "i_", "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "3"}], "]"}], "*", 
          RowBox[{"lamQ7f3", "[", "3", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"gWtiQ", "[", 
          RowBox[{"i_", ",", "j_"}], "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "j"}], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "1"}], "]"}], "*", "0"}], "+", 
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "2"}], "]"}], "*", "0"}], "+", 
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "3"}], "]"}], 
             RowBox[{"gWqf", "[", 
              RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{"gWtiLe", "[", 
          RowBox[{"i_", ",", "j_"}], "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"i", ",", "j"}], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "1"}], "]"}], 
             RowBox[{"gWLf", "[", 
              RowBox[{"1", ",", "1"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "2"}], "]"}], 
             RowBox[{"gWLf", "[", 
              RowBox[{"2", ",", "2"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"i", ",", "3"}], "]"}], 
             RowBox[{"gWLf", "[", 
              RowBox[{"3", ",", "3"}], "]"}]}]}], ")"}]}]}]}], "}"}]}], ",", 
     RowBox[{"\"\<Collection\>\"", "->", "\"\<MultiParticleCollection\>\""}], 
     ",", 
     RowBox[{"\"\<Model\>\"", "\[Rule]", "\"\<Q1_Q7_W\>\""}]}], "}"}]}], 
  "]"}]], "Input",
