(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)
M$ModelName = "Omega2";


FeynmanGauge = True;

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {

S[667]=={ClassName->Sa,
SelfConjugate->False,
QuantumNumbers->{Y-> 2/3},
Indices->{Index[SU36]},
FullName->"heavy",
Mass->MSa,
Width->0}};

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* External parameters *)

  (* Internal Parameters *)
  
MSa== { 
    ParameterType     -> Internal, 
    ComplexParameter  -> False
  },
TS11=={
ParameterType->Internal,
Indices-> {Index[SU2D], Index[SU2D]},
ComplexParameter->True},
TC11=={
ParameterType->Internal,
Indices-> {Index[SU36], Index[SU36]},
ComplexParameter->True},
L1=={
ParameterType->Internal,
ComplexParameter->False},
TC21=={
ParameterType->Internal,
Indices-> {Index[SU36], Index[SU36], Index[SU36], Index[SU36]},
ComplexParameter->True},
TC23=={
ParameterType->Internal,
Indices-> {Index[SU36], Index[SU36], Index[SU36], Index[SU36]},
ComplexParameter->True},
L2=={
ParameterType->Internal,
ComplexParameter->False},
L3=={
ParameterType->Internal,
ComplexParameter->False},
TC31=={
ParameterType->Internal,
Indices-> {Index[Colour], Index[Colour], Index[SU36]},
ComplexParameter->True},
L4=={
ParameterType->Internal,
Indices-> {Index[Generation],Index[Generation]},
ComplexParameter->True}};


(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

gotoBFM={G[a__]->G[a]+GQuantum[a],Wi[a__]->Wi[a]+WiQuantum[a],B[a__]->B[a]+BQuantum[a]};


LHeavy := Block[{mu,ii,cc,nn}, DC[Sa[nn], mu]*DC[Sabar[nn], mu] + MSa^2 Sabar Sa ]/.gotoBFM;

 LNP:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},L4[ff0,ff1] CC[DRbar[sp1,ff0,cc0]].DR[sp1,ff1,cc1] Sa[cc2] TC31[cc0, cc1, cc2]];

 LNPH:= Block[{sp1,ff0,ff1,ss0,ss1,ss2,ss3,ss4,cc1,cc2,cc3,cc4},L1 Phibar[ss0] Sabar[cc1] Phi[ss2] Sa[cc3] TC11[cc1, cc3] TS11[ss0, ss2] + L2 Sabar[cc0] Sabar[cc1] Sa[cc2] Sa[cc3] TC21[cc0, cc1, cc2, cc3] + L3 Sabar[cc0] Sabar[cc1] Sa[cc2] Sa[cc3] TC23[cc0, cc1, cc2, cc3]];

Ltot := LSM + LHeavy + LNP + HC[LNP] + LNPH;