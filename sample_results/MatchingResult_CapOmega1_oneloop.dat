             ydbar[MIF1, mif2] - 16*L4bar[fl1, mif2]*L5[fl2, mif1]*
             yu[fl2, fl1] - 16*invepsilonbar*L4bar[fl1, mif2]*L5[fl2, mif1]*
             yu[fl2, fl1] + 16*L4bar[fl1, mif2]*L5[fl2, mif1]*
             Log[MSa^2/\[Mu]^2]*yu[fl2, fl1])/(384*Pi^2)), 
      alphaOlambdae[mif1_, mif2_] -> yl[mif1, mif2], 
      alphaOlambdaebar[mif1_, mif2_] -> ylbar[mif1, mif2], 
      alphaOlambdau[mif1_, mif2_] -> yu[mif1, mif2] + 
        onelooporder*(-(muH^2*L4[fl1, mif2]*L5bar[fl2, mif1]*ydbar[fl2, fl1])/
           (48*MSa^2*Pi^2) - (muH^2*(L4[fl1, mif2]*L5bar[fl2, mif1]*
              ydbar[fl2, fl1] + 2*invepsilonbar*L4[fl1, mif2]*
              L5bar[fl2, mif1]*ydbar[fl2, fl1] - 2*L4[fl1, mif2]*
              L5bar[fl2, mif1]*Log[MSa^2/\[Mu]^2]*ydbar[fl2, fl1]))/
           (96*MSa^2*Pi^2) + (16*L4[fl1, mif2]*L5bar[fl2, mif1]*
             ydbar[fl2, fl1] + 16*invepsilonbar*L4[fl1, mif2]*
             L5bar[fl2, mif1]*ydbar[fl2, fl1] - 16*L4[fl1, mif2]*
             L5bar[fl2, mif1]*Log[MSa^2/\[Mu]^2]*ydbar[fl2, fl1] - 
            L4[fl1, mif2]*L4bar[fl1, MIF1]*yu[mif1, MIF1] - 
            2*invepsilonbar*L4[fl1, mif2]*L4bar[fl1, MIF1]*yu[mif1, MIF1] + 
            2*L4[fl1, mif2]*L4bar[fl1, MIF1]*Log[MSa^2/\[Mu]^2]*
             yu[mif1, MIF1] - 4*L5[fl1, MIF1]*L5bar[fl1, mif1]*
             yu[MIF1, mif2] - 8*invepsilonbar*L5[fl1, MIF1]*L5bar[fl1, mif1]*
             yu[MIF1, mif2] + 8*L5[fl1, MIF1]*L5bar[fl1, mif1]*
             Log[MSa^2/\[Mu]^2]*yu[MIF1, mif2])/(384*Pi^2)), 
      alphaOlambdaubar[mif1_, mif2_] -> yubar[mif1, mif2] + 
        onelooporder*(-(muH^2*L4bar[fl1, mif2]*L5[fl2, mif1]*yd[fl2, fl1])/
           (48*MSa^2*Pi^2) - (muH^2*(L4bar[fl1, mif2]*L5[fl2, mif1]*
              yd[fl2, fl1] + 2*invepsilonbar*L4bar[fl1, mif2]*L5[fl2, mif1]*
              yd[fl2, fl1] - 2*L4bar[fl1, mif2]*L5[fl2, mif1]*
              Log[MSa^2/\[Mu]^2]*yd[fl2, fl1]))/(96*MSa^2*Pi^2) + 
          (16*L4bar[fl1, mif2]*L5[fl2, mif1]*yd[fl2, fl1] + 
            16*invepsilonbar*L4bar[fl1, mif2]*L5[fl2, mif1]*yd[fl2, fl1] - 
            16*L4bar[fl1, mif2]*L5[fl2, mif1]*Log[MSa^2/\[Mu]^2]*
             yd[fl2, fl1] - L4[fl1, MIF1]*L4bar[fl1, mif2]*
             yubar[mif1, MIF1] - 2*invepsilonbar*L4[fl1, MIF1]*
             L4bar[fl1, mif2]*yubar[mif1, MIF1] + 2*L4[fl1, MIF1]*
             L4bar[fl1, mif2]*Log[MSa^2/\[Mu]^2]*yubar[mif1, MIF1] - 
            4*L5[fl1, mif1]*L5bar[fl1, MIF1]*yubar[MIF1, mif2] - 
            8*invepsilonbar*L5[fl1, mif1]*L5bar[fl1, MIF1]*
             yubar[MIF1, mif2] + 8*L5[fl1, mif1]*L5bar[fl1, MIF1]*
             Log[MSa^2/\[Mu]^2]*yubar[MIF1, mif2])/(384*Pi^2))}, 
     {g1 -> g1*(1 + (onelooporder*((g1^2*invepsilonbar)/(72*Pi^2) - 
            (g1^2*Log[MSa^2/\[Mu]^2])/(72*Pi^2)))/2), g2 -> g2, 
      g3 -> g3*(1 + (onelooporder*((5*g3^2*invepsilonbar)/(96*Pi^2) - 
            (5*g3^2*Log[MSa^2/\[Mu]^2])/(96*Pi^2)))/2)}}
 
Coupling /: MakeBoxes[Coupling[gL], NiceForm] := 
     Format[Subscript[g, SubscriptStyle[Format[L, NiceForm]]], NiceForm]
 
Coupling /: MakeBoxes[Coupling[gs], NiceForm] := 
     Format[Subscript[g, SubscriptStyle[Format[s, NiceForm]]], NiceForm]
 
Coupling /: MakeBoxes[Coupling[gY], NiceForm] := 
     Format[Subscript[g, SubscriptStyle[Format[Y, NiceForm]]], NiceForm]
 
Coupling /: MakeBoxes[Coupling[Yu, ind_], NiceForm] := 
     Format[Subsuperscript[Y, SubscriptStyle[Format[u, NiceForm]], 
       SubscriptStyle[Row[(Format[#1, NiceForm] & ) /@ ind]]], NiceForm]
 
Coupling /: MakeBoxes[Coupling[Yd, ind_], NiceForm] := 
     Format[Subsuperscript[Y, SubscriptStyle[Format[d, NiceForm]], 
       SubscriptStyle[Row[(Format[#1, NiceForm] & ) /@ ind]]], NiceForm]
 
Coupling /: MakeBoxes[Coupling[Ye, ind_], NiceForm] := 
     Format[Subsuperscript[Y, SubscriptStyle[Format[e, NiceForm]], 
       SubscriptStyle[Row[(Format[#1, NiceForm] & ) /@ ind]]], NiceForm]
 
Coupling /: MakeBoxes[Coupling[label_, ind_], NiceForm] := 
     Format[Subsuperscript[C, SubscriptStyle[
        Format[Symbol[StringReplace[ToString[label], "C" -> ""]], NiceForm]], 
       SubscriptStyle[Row[(Format[#1, NiceForm] & ) /@ ind]]], NiceForm]
 
Coupling /: MakeBoxes[Coupling[label:\[Mu] | \[Lambda]], NiceForm] := 
     Format[label, NiceForm]
 
Coupling /: MakeBoxes[Coupling[label_], NiceForm] := 
     Format[Subscript[C, SubscriptStyle[Format[label, NiceForm]]], NiceForm]
 
Attributes[MakeBoxes] = {HoldAllComplete}
 
ParentForm[NiceForm] ^= StandardForm
 
Attributes[Subscript] = {NHoldRest}
 
SubscriptStyle[x_] := Style[x, FontSize -> 10]
 
Attributes[Subsuperscript] = {NHoldRest, ReadProtected}
