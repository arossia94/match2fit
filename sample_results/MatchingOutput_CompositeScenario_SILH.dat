    (g3^4*KroneckerDelta[mif1, mif2]*KroneckerDelta[mif3, mif4])/
     (12*gSt^2*mSt^2), alphaOuW[mif1_, mif2_] -> 0, 
  alphaOuWbar[mif1_, mif2_] -> 0, alphaOlambdad[mif1_, mif2_] -> 
   yd[mif1, mif2], alphaOlambdadbar[mif1_, mif2_] -> ydbar[mif1, mif2], 
  alphaOlambdae[mif1_, mif2_] -> yl[mif1, mif2], 
  alphaOlambdaebar[mif1_, mif2_] -> ylbar[mif1, mif2], 
  alphaOlambdau[mif1_, mif2_] -> yu[mif1, mif2], 
  alphaOlambdaubar[mif1_, mif2_] -> yubar[mif1, mif2]}, 
 {g1 -> g1, g2 -> g2, g3 -> g3}}
